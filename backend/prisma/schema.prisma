

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ApiIntegration {
  id             Int      @id @default(autoincrement())
  name           String
  description    String
  host           String
  username       String
  password       String
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastModifiedBy String

  users          ApiIntegrationUser[]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String?  @unique
  role      String   @default("VISUALIZACAO")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  apiIntegrations ApiIntegrationUser[]
}

model ApiIntegrationUser {
  id               Int            @id @default(autoincrement())
  apiIntegrationId Int
  userId           Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  apiIntegration   ApiIntegration @relation(fields: [apiIntegrationId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@unique([apiIntegrationId, userId])
}